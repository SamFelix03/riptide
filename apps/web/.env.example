# Web app is pinned to Base Sepolia (84532).
# Addresses and RPC come from deployments/84532.json via GET /api/config.

# Reown AppKit project id (dashboard.reown.com). Required to open the connect modal.
NEXT_PUBLIC_PROJECT_ID=
# Accepted alias for the same value:
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional operator overrides for the Next.js server
# RPC_URL=
# SOLVER_API_URL=
