# RIPTIDE environment index
# Copy per-package examples: node scripts/copy-env.mjs
# Never commit real .env files.
#
# Addresses, public RPC, explorer, feed, subgraph URL:
#   deployments/<chainId>.json
# Public defaults (Base Sepolia RPC, service ports):
#   packages/contracts/src/networks.ts
#
# Env is secrets + optional overrides only. See ENV.md.
# The web app is pinned to Base Sepolia and ignores CHAIN_ID.

# Optional root overrides for services/scripts (not the web app):
# CHAIN_ID=31337
# RPC_URL=
# SOLVER_API_URL=
